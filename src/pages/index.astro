---
import App from '@/App'
import { terminalOutputMarkdown } from '@/data/terminalOutput.server'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { safeRenderMarkdownToNodes } from '@/utils/sanitizeHtml.server'

const pageTitle = 'Damian Poole'
const pageDescription =
    'Personal site of Damian Poole with a terminal-style homepage, blog, and projects.'
const outputNodes = safeRenderMarkdownToNodes(terminalOutputMarkdown)
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    showNoscriptFallback
>
    <App client:load outputNodes={outputNodes} />
</BaseLayout>
