---
import {
    getCollection,
    getEntry,
    render,
    type CollectionEntry,
} from 'astro:content'
import ContentLayout from '@/layouts/ContentLayout.astro'

export async function getStaticPaths() {
    const entries = await getCollection('blog')

    return entries
        .filter(
            (entry: CollectionEntry<'blog'>) =>
                !import.meta.env.PROD || !entry.data.draft
        )
        .map((entry: CollectionEntry<'blog'>) => ({
            params: { slug: entry.id },
        }))
}

const { slug } = Astro.params

if (!slug) {
    throw new Error('Expected blog slug parameter.')
}

const post = await getEntry('blog', slug)

if (!post || (import.meta.env.PROD && post.data.draft)) {
    return Astro.redirect('/404')
}

const tags = post.data.tags as string[]

const { Content } = await render(post)

const pageTitle = `${post.data.title} | Damian Poole`
const canonicalUrl = `https://damianpoole.com/blog/${post.id}/`

const formatDate = (date: Date) =>
    date.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    })
---

<ContentLayout
    title={pageTitle}
    pageTitle={post.data.title}
    description={post.data.description}
    eyebrow="Blog"
    canonicalUrl={canonicalUrl}
    ogType="article"
    activeTab="blog"
>
    <div
        class="text-cat-subtext0 mb-8 flex flex-wrap items-center gap-3 text-sm"
    >
        <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
        </time>
        {
            post.data.draft && (
                <span class="border-cat-yellow/40 text-cat-yellow rounded-full border px-2 py-1">
                    Draft
                </span>
            )
        }
        {
            tags.map((tag) => (
                <span class="bg-cat-surface0 text-cat-blue rounded-full px-3 py-1 font-mono">
                    #{tag}
                </span>
            ))
        }
    </div>

    <article class="prose prose-invert prose-lg max-w-none leading-relaxed">
        <Content />
    </article>
</ContentLayout>
