---
import { getCollection, type CollectionEntry } from 'astro:content'
import ContentLayout from '@/layouts/ContentLayout.astro'

const showEntry = (draft: boolean) => !import.meta.env.PROD || !draft

const posts = (await getCollection('blog'))
    .filter((entry: CollectionEntry<'blog'>) => showEntry(entry.data.draft))
    .sort(
        (left: CollectionEntry<'blog'>, right: CollectionEntry<'blog'>) =>
            right.data.pubDate.getTime() - left.data.pubDate.getTime()
    ) as CollectionEntry<'blog'>[]

const pageTitle = 'Blog | Damian Poole'
const pageDescription = 'Notes on engineering, tooling, and projects.'
const canonicalUrl = 'https://damianpoole.com/blog/'

const formatDate = (date: Date) =>
    date.toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
    })
---

<ContentLayout
    title={pageTitle}
    pageTitle="Blog"
    description={pageDescription}
    eyebrow="Writing"
    canonicalUrl={canonicalUrl}
>
    <section class="flex flex-col gap-6">
        {
            posts.map((post) =>
                (() => {
                    const tags = post.data.tags as string[]

                    return (
                        <article class="border-cat-surface1 bg-cat-base/30 rounded-xl border p-6">
                            <div class="text-cat-subtext0 mb-3 flex flex-wrap items-center gap-3 text-sm">
                                <time
                                    datetime={post.data.pubDate.toISOString()}
                                >
                                    {formatDate(post.data.pubDate)}
                                </time>
                                {post.data.draft && (
                                    <span class="border-cat-yellow/40 text-cat-yellow rounded-full border px-2 py-1">
                                        Draft
                                    </span>
                                )}
                            </div>
                            <h2 class="mb-3 text-2xl font-semibold tracking-tight">
                                <a
                                    class="hover:text-cat-blue transition-colors"
                                    href={`/blog/${post.id}/`}
                                >
                                    {post.data.title}
                                </a>
                            </h2>
                            <p class="text-cat-subtext0 mb-4 leading-relaxed">
                                {post.data.description}
                            </p>
                            {tags.length > 0 && (
                                <ul class="text-cat-blue flex flex-wrap gap-2 font-mono text-sm">
                                    {tags.map((tag) => (
                                        <li class="bg-cat-surface0 rounded-full px-3 py-1">
                                            #{tag}
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </article>
                    )
                })()
            )
        }
    </section>
</ContentLayout>
