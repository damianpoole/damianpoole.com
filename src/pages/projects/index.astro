---
import { getCollection, type CollectionEntry } from 'astro:content'
import ContentLayout from '@/layouts/ContentLayout.astro'

const showEntry = (draft: boolean) => !import.meta.env.PROD || !draft

const projects = (await getCollection('projects'))
    .filter((entry: CollectionEntry<'projects'>) => showEntry(entry.data.draft))
    .sort(
        (
            left: CollectionEntry<'projects'>,
            right: CollectionEntry<'projects'>
        ) => left.data.order - right.data.order
    ) as CollectionEntry<'projects'>[]

const pageTitle = 'Projects | Damian Poole'
const pageDescription =
    'Selected projects, experiments, and things built for the web.'
const canonicalUrl = 'https://damianpoole.com/projects/'
---

<ContentLayout
    title={pageTitle}
    pageTitle="Projects"
    description={pageDescription}
    eyebrow="Work"
    canonicalUrl={canonicalUrl}
    activeTab="projects"
>
    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
            projects.map((project) => {
                const tech = project.data.tech as string[]

                return (
                    <article class="border-cat-surface1 bg-cat-mantle/35 flex h-full flex-col rounded-xl border p-5">
                        <div class="mb-4 flex items-start justify-between gap-3">
                            <div>
                                <h2 class="mb-3 text-xl font-semibold tracking-tight">
                                    <a
                                        class="hover:text-cat-blue transition-colors"
                                        href={`/projects/${project.id}/`}
                                    >
                                        {project.data.title}
                                    </a>
                                </h2>
                                <p class="text-cat-subtext0 leading-relaxed">
                                    {project.data.description}
                                </p>
                            </div>
                            {project.data.draft && (
                                <span class="border-cat-yellow/40 text-cat-yellow rounded-full border px-2 py-1 text-sm">
                                    Draft
                                </span>
                            )}
                        </div>

                        <div class="mt-auto flex flex-col gap-4">
                            <ul class="text-cat-blue flex flex-wrap gap-2 font-mono text-sm">
                                {tech.map((item) => (
                                    <li class="bg-cat-surface0 rounded-full px-3 py-1">
                                        {item}
                                    </li>
                                ))}
                            </ul>

                            <div class="flex flex-wrap gap-4 text-sm">
                                <a
                                    class="text-cat-blue hover:underline"
                                    href={`/projects/${project.id}/`}
                                >
                                    Details
                                </a>
                                {project.data.githubUrl && (
                                    <a
                                        class="text-cat-blue hover:underline"
                                        href={project.data.githubUrl}
                                    >
                                        Source
                                    </a>
                                )}
                                {project.data.liveUrl && (
                                    <a
                                        class="text-cat-blue hover:underline"
                                        href={project.data.liveUrl}
                                    >
                                        Live Demo
                                    </a>
                                )}
                            </div>
                        </div>
                    </article>
                )
            })
        }
    </section>
</ContentLayout>
