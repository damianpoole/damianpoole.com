---
import '@fontsource/geist-sans'
import '@fontsource/geist-mono'
import StaticTerminal from '@/components/StaticTerminal'
import '../index.css'

interface Props {
    title?: string
    description?: string
}

const {
    title = 'Damian Poole',
    description = 'Personal site of Damian Poole.',
} = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <noscript>
            <div
                class="flex min-h-screen w-full flex-col bg-[#303446] text-[#c6d0f5]"
            >
                <StaticTerminal />
            </div>
        </noscript>
        <slot />
    </body>
</html>
