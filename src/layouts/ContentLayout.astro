---
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
    title: string
    description: string
    eyebrow?: string
}

const { title, description, eyebrow } = Astro.props
---

<BaseLayout title={title} description={description}>
    <main
        class="mx-auto flex min-h-screen w-full max-w-4xl flex-col px-4 py-10 md:px-8 md:py-16"
    >
        <div
            class="border-cat-surface1 mb-10 flex flex-col gap-4 border-b pb-8"
        >
            {
                eyebrow && (
                    <p class="text-cat-blue font-mono text-sm tracking-[0.2em] uppercase">
                        {eyebrow}
                    </p>
                )
            }
            <h1
                class="text-foreground text-4xl font-semibold tracking-tight md:text-5xl"
            >
                {title}
            </h1>
            <p class="text-cat-subtext0 max-w-2xl text-lg leading-relaxed">
                {description}
            </p>
        </div>
        <slot />
    </main>
</BaseLayout>
