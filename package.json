{
    "name": "damianpoole-website",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.3.0",
    "engines": {
        "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "prepare": "vp config --no-agent",
        "dev": "astro dev",
        "build": "astro build",
        "typecheck": "astro check",
        "lint": "vp lint . && pnpm lint:astro",
        "lint:astro": "eslint src --ext .astro",
        "fmt": "vp fmt .",
        "fmt:check": "vp fmt --check .",
        "check": "vp check && pnpm lint:astro && astro check",
        "test": "vp test run",
        "prettier:write": "vp fmt .",
        "prettier:check": "vp fmt --check .",
        "preview": "astro preview"
    },
    "dependencies": {
        "@astrojs/react": "^6.0.4",
        "@astrojs/sitemap": "^3.7.3",
        "@fontsource/geist-mono": "^5.2.7",
        "@fontsource/geist-sans": "^5.2.5",
        "astro": "^7.2.9",
        "dompurify": "^3.4.16",
        "highlight.js": "^11.11.1",
        "jsdom": "^29.0.2",
        "lucide-react": "^1.8.0",
        "marked": "^15.0.12",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/parser": "^8.58.2",
        "eslint": "^9",
        "eslint-plugin-astro": "^1.7.0",
        "globals": "^17.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5",
        "vite": "catalog:",
        "vite-plus": "catalog:"
    }
