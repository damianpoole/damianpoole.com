{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "useDefineForClassFields": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        ".astro/types.d.ts",
        "astro.config.ts",
        "vite.config.ts",
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": ["node_modules", "dist"]
}
